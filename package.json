{
  "name": "trace-ml",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "sync:opener-scope": "node scripts/sync-opener-scope.mjs",
    "predev": "npm run sync:pyodide",
    "dev": "vite",
    "prebuild": "npm run sync:pyodide && npm run sync:opener-scope",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "lucide-react": "^1.28.0",
    "pyodide": "314.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
